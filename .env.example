# AI Hub에서 발급받은 API key. 실제 값이 든 .env는 Git에 커밋하지 않습니다.
AIHUB_APIKEY=

# 로컬 가족 목소리 시연. 서버 실행 전에 별도로 환경 변수로 주입합니다.
# 관리 토큰과 구분하며 실제 키는 Git에 저장하지 않습니다.
KOF5_LOCAL_STUDIO=0
# seed_portal.py가 로컬 계정 UUID·공개 키·저장 경로를 runs/local-studio/portal.env에 기록합니다.
# scripts/run_local_portal.py가 읽으며, 관리 키나 실제 자격 증명은 저장하지 않습니다.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
