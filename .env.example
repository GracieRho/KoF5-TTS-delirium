# .env로 복사한 뒤 이 파일 대신 .env에서 실제 값을 설정합니다.
ELEVENLABS_API_KEY=
# 연구자만 아는 임의의 긴 문자열 (최소 16자)
FAVILIUM_ACCESS_CODE=
# 접속 코드와 별개로 생성한 고정 임의 문자열 (32자 이상)
FAVILIUM_SESSION_SECRET=

# 로컬/자체 호스팅에서 재시작 뒤에도 보존되는 SQLite 파일 경로
FAVILIUM_DB_PATH=.cache/favilium/voices.sqlite3

# Vercel에서는 전용 Supabase 프로젝트에 clinical/voice_sessions.sql을 적용합니다.
FAVILIUM_SUPABASE_URL=
FAVILIUM_SUPABASE_SERVICE_KEY=
