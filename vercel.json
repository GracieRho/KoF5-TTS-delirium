{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app:app",
      "buildCommand": "npm --prefix apps/portal_web ci && npm --prefix apps/portal_web run build && python -c \"from app import app; assert callable(app)\"",
      "functions": {
        "app.py": {
          "includeFiles": "apps/portal_web/dist/**",
          "excludeFiles": "{.git/**,.worktrees/**,.venv/**,.cache/**,.env*,secrets/**,apps/portal_web/node_modules/**,architecture/**,clinical/**,docs/**,recordings/**,scripts/**,tests/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "app" } }
  ],
  "git": { "deploymentEnabled": { "feat/adaptive-care-research": false, "main": false } }
}
